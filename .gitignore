# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code runtime state (per-machine; not for the repo)
.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# eval-driver output (per-run analyzer dumps; reproducible via npm run eval:deep-analyzer)
/_plans/eval-runs/

# v2 style-spike outputs (contain 7-day-presigned R2 URLs for refs +
# 40+ generated images; reproducible via npm scripts; never commit)
/_plans/2026-05-21-phase-0-spike-results/

# v2 style-refs sweeper transient logs (if added later)
/_plans/sweep-runs/

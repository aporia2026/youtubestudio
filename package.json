{
  "name": "youtube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts up",
    "set-password": "tsx --env-file-if-exists=.env.local scripts/set-password.ts",
    "diagnose-login": "tsx --env-file-if-exists=.env.local scripts/diagnose-login.ts",
    "db:status": "tsx --env-file-if-exists=.env.local scripts/migrate.ts status",
    "deploy:remotion": "tsx --env-file-if-exists=.env.local scripts/deploy-remotion-site.ts",
    "smoke:lambda": "tsx --env-file-if-exists=.env.local scripts/lambda-smoke.ts",
    "smoke:align": "tsx --env-file-if-exists=.env.local scripts/align-smoke.ts",
    "remotion": "dotenv -e .env.local -- remotion",
    "remotion:lambda": "dotenv -e .env.local -- remotion lambda"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/openai": "^3.0.50",
    "@anthropic-ai/sdk": "^0.82.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remotion/bundler": "4.0.460",
    "@remotion/cli": "4.0.460",
    "@remotion/google-fonts": "4.0.460",
    "@remotion/lambda": "4.0.460",
    "@remotion/media-parser": "4.0.460",
    "@remotion/media-utils": "4.0.460",
    "@remotion/player": "4.0.460",
    "@remotion/renderer": "4.0.460",
    "@remotion/transitions": "4.0.460",
    "@remotion/webcodecs": "4.0.460",
    "@sendgrid/mail": "^8.1.6",
    "@vercel/blob": "^2.3.3",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.3.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "next-themes": "^0.4.6",
    "openai": "^6.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "4.0.460",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "undici": "^6.24.1",
    "wavesurfer.js": "^7.12.6",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.3.6"
